    "@pomeranian/typescript-config": "workspace:*",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "@types/node": "22.20.4",
    "@types-node24/node": "npm:@types/node@24.13.6"
  }
}
