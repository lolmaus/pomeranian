{
  "name": "@pomeranian/lib-essential",
  "private": true,
  "type": "module",
  "exports": {
    "./element-po": "./src/element-po.mts"
  },
  "scripts": {
    "lint": "oxlint --config oxlint.config.mts . --ignore-pattern '**/*.stories.tsx' --max-warnings 0 && oxlint --config oxlint.react.config.mts src --max-warnings 0",
    "lint:fix": "oxlint --config oxlint.config.mts . --ignore-pattern '**/*.stories.tsx' --max-warnings 0 --fix && oxlint --config oxlint.react.config.mts src --max-warnings 0 --fix",
    "typecheck": "tsc --noEmit --project tsconfig.library.json && tsc --noEmit --project tsconfig.node.json && tsc --noEmit --project tsconfig.types.json && tsc --noEmit --project tsconfig.playwright.json && tsc --noEmit --project tsconfig.browser.json",
    "test:unit": "node --test src/*.test.mts"
  },
  "dependencies": {
    "@pomeranian/core": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "1.63.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@pomeranian/oxlint-config": "workspace:*",
    "@pomeranian/typescript-config": "workspace:*",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "@types/node": "22.20.4",
    "@types-node24/node": "npm:@types/node@24.13.6",
    "@pomeranian/demo-app-react": "workspace:*",
    "@pomeranian/tests-e2e": "workspace:*",
    "react": "19.3.0",
    "@types/react": "19.3.0"
  }
}
