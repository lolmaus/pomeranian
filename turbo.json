{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    ".nvmrc",
    ".gitignore",
    "pnpm-workspace.yaml",
    "pnpm-lock.yaml",
    "tsconfig.json",
    "packages/oxlint-config/*.json",
    "packages/oxlint-config/*.mts",
    "packages/typescript-config/*.json"
  ],
  "tasks": {
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "outputs": []
    }
  }
}
