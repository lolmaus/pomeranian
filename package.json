{
  "name": "pomeranian",
  "private": true,
  "scripts": {
    "format": "oxfmt --check --disable-nested-config .",
    "format:fix": "oxfmt --write --disable-nested-config .",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.27.1",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "turbo": "2.11.2",
    "typescript": "7.0.2"
  }
}
