{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortPackageJson": false,
  "ignorePatterns": [
    ".agents/skills/**",
    "skills-lock.json",
    ".scratch/**",
    "pnpm-lock.yaml",
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/.turbo/**",
    "**/.cache/**",
    "**/dist/**",
    "**/build/**",
    "**/coverage/**",
    "**/test-results/**",
    "**/playwright-report/**",
    "**/*.tsbuildinfo"
  ]
}
